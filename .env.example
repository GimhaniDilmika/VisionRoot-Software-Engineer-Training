# ==============================================================================
# VisionRoot Service Request Management System — Root Environment Template
# ==============================================================================
# This template documents all environment variables used across frontend and backend.
# DO NOT commit real secrets, tokens, or production credentials to Git.
#
# SETUP INSTRUCTIONS:
# 1. Copy backend variables to backend/.env:
#    cp .env.example backend/.env
# 2. Copy frontend variables to frontend/.env.local:
#    cp .env.example frontend/.env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration (Reserved for Day 06)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=service_request_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Consolidated Database URL
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/service_request_db

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api

