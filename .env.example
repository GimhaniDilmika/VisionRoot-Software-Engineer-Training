# ==============================================================================
# VisionRoot Service Request Management System — Root Environment Template
# ==============================================================================
# This template documents all environment variables used across frontend and backend.
# DO NOT commit real secrets, tokens, or production credentials to Git.
#
# SETUP INSTRUCTIONS:
# 1. Copy backend variables to backend/.env:
#    Windows PowerShell: Copy-Item backend\.env.example backend\.env
#    Bash / POSIX:       cp backend/.env.example backend/.env
#
# 2. Copy frontend variables to frontend/.env.local:
#    Windows PowerShell: Copy-Item frontend\.env.example frontend\.env.local
#    Bash / POSIX:       cp frontend/.env.example frontend/.env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# Server listening port (default: 5000)
PORT=5000

# Runtime environment ('development', 'production', or 'test')
NODE_ENV=development

# Allowed CORS client origin (Next.js frontend in development)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visionroot_service_requests
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# PostgreSQL Connection Pool Settings (pg.Pool)
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Consolidated Database URL (Takes precedence over DB_* if provided)
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/visionroot_service_requests

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.local)
# ------------------------------------------------------------------------------
# Public API base endpoint for Next.js client data fetching
NEXT_PUBLIC_API_URL=http://localhost:5000/api
