# ==============================================================================
# VisionRoot Backend Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT: Copy this file to .env before starting the Express backend:
#   Windows PowerShell: Copy-Item .env.example .env
#   Bash / POSIX:       cp .env.example .env
#
# SECURITY NOTICE:
# - Never commit real passwords, secret tokens, or private keys to version control.
# - backend/.env is strictly excluded by .gitignore.
# - Keep production database passwords strong and rotate credentials periodically.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Network & Runtime Configuration
# ------------------------------------------------------------------------------
# Port the Express HTTP server listens on (default: 5000)
PORT=5000

# Node execution environment ('development', 'production', or 'test')
# In 'production', detailed error stack traces are suppressed in API responses.
NODE_ENV=development

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) Configuration
# ------------------------------------------------------------------------------
# Allowed client origin that may send cross-origin HTTP requests with credentials.
# Development default: http://localhost:3000 (Next.js client)
# Production: Set to your public frontend origin (e.g., https://app.yourdomain.com)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection (Discrete Variables)
# ------------------------------------------------------------------------------
# Hostname or IP address of the PostgreSQL database server
DB_HOST=localhost

# PostgreSQL port (default: 5432)
DB_PORT=5432

# PostgreSQL database name
DB_NAME=visionroot_service_requests

# PostgreSQL user account
DB_USER=postgres

# PostgreSQL user password (DO NOT commit real passwords)
DB_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# PostgreSQL Connection Pool Settings (pg.Pool)
# ------------------------------------------------------------------------------
# Maximum number of clients in the connection pool (default: 20)
DB_MAX_CONNECTIONS=20

# Number of milliseconds a client must sit idle in the pool before being closed (default: 30000)
DB_IDLE_TIMEOUT_MS=30000

# Milliseconds to wait before timing out when connecting a new client (default: 5000)
DB_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Consolidated PostgreSQL Connection URL (Alternative / Cloud Deployments)
# ------------------------------------------------------------------------------
# If set, pool.ts prefers DATABASE_URL over discrete DB_* variables above.
# Useful for managed cloud databases (AWS RDS, Render, Railway, Supabase).
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/visionroot_service_requests
