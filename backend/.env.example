# ==============================================================================
# VisionRoot Backend Environment Configuration Template (.env.example)
# IMPORTANT: Copy this file to .env before starting the backend.
# Never commit real passwords, secrets, or .env files to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Frontend Client Origin (for Cross-Origin Resource Sharing - CORS)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration (Used in Day 06)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=service_request_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Consolidated Database URL Connection String
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/service_request_db

