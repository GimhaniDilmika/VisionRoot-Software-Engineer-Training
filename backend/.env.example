# ==============================================================================
# VisionRoot Backend Environment Configuration Template (.env.example)
# IMPORTANT: Copy this file to .env before starting the backend.
# Never commit real passwords, secrets, or .env files to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Frontend Client Origin (for Cross-Origin Resource Sharing - CORS)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration (Day 06 — Database and Persistence)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visionroot_service_requests
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# PostgreSQL Connection Pool Settings (Optional overrides)
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Consolidated Database URL Connection String (Alternative to discrete DB_* variables)
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/visionroot_service_requests

