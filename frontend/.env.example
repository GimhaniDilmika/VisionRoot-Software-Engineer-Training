# ==============================================================================
# VisionRoot Frontend Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT: Copy this file to .env.local before starting the Next.js development server:
#   Windows PowerShell: Copy-Item .env.example .env.local
#   Bash / POSIX:       cp .env.example .env.local
#
# SECURITY NOTICE:
# - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser client.
# - NEVER store database credentials, private keys, or API secrets in this file.
# - .env.local is strictly git-ignored to prevent credential leaks.
# ==============================================================================

# Backend REST API Base URL
# The Next.js frontend fetches service request data from this Express API endpoint.
# Development default: http://localhost:5000/api
# Production: Set to your reverse proxy or public API origin (e.g., https://api.yourdomain.com/api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
