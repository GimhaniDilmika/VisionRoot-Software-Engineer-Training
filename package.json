{
  "name": "visionroot-service-request-management-system",
  "version": "1.0.0",
  "description": "VisionRoot Service Request Management System - Modular Monolith Monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm run start --workspace=backend",
    "start:frontend": "npm run start --workspace=frontend",
    "type-check:backend": "npm run type-check --workspace=backend",
    "type-check:frontend": "npm run type-check --workspace=frontend",
    "type-check": "npm run type-check:backend && npm run type-check:frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "test": "npm run test:backend && npm run test:frontend:unit",
    "test:backend": "npm run test --workspace=backend",
    "test:backend:unit": "npm run test:unit --workspace=backend",
    "test:backend:integration": "npm run test:integration --workspace=backend",
    "test:backend:coverage": "npm run test:coverage --workspace=backend",
    "test:frontend:unit": "npm run test:unit --workspace=frontend",
    "test:frontend:coverage": "npm run test:coverage --workspace=frontend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend"
  },
  "keywords": [
    "visionroot",
    "modular-monolith",
    "service-requests",
    "typescript",
    "express",
    "nextjs",
    "postgresql"
  ],
  "author": "Gimhani Dilmika <gimhanidilmika1@gmail.com>",
  "license": "UNLICENSED"
}

